@startuml
skinparam handwritten false
skinparam class {
    BackgroundColor White
    ArrowColor #7C3AED
    BorderColor #DB2777
}

class LayoutPrincipal {
    +chatBotRefRef : MutableRefObject
    +perfil : PerfilUsuario
    +usuario : UsuarioProps
    +listaEscolar : EscolaProps
    +atualizarPerfilLocal() : void
    +abrirChatComAjuda() : void
    +render()
}

class GerenciadorTelas {
    +usuario : UsuarioProps
    +listaEscolar : EscolaProps
    +perfil : PerfilUsuario
    +mudarInscricao() : void
    +estaInscrito() : boolean
    +marcarMural() : void
    +navegarPara() : void
    +render()
}

class ProtectedRoute {
    +session : Session
    +loading : boolean
    +perfil : PerfilUsuario
    +render()
}

class useAuth {
    +session : Session | null
    +loading : boolean
    +perfil : PerfilUsuario | null
    +materiasProfessor : TurmaProfessor[]
    +materiasProfessorNomes : string[]
    +atualizarPerfilLocal(perfilAtualizado: PerfilUsuario) : void
}

class useGerenciador {
    +usuario : UsuarioProps
    +pedirAjuda : boolean
    +loadingInscricoes : boolean
    +mudarInscricao(turmaId: string) : Promise
    +estaInscrito(materia: string) : boolean
    +marcarMural(key: string) : void
    +navegarPara(tela: OpcoesTela) : void
    +abrirChat(contatoId: string) : void
    +limparEstado() : void
}

class useEscolaDados {
    +listaEscolar : EscolaProps
    +carregandoEscola : boolean
    +erroEscola : string | null
    +carregar() : Promise
}

class ChatBot {
    +usuario : UsuarioProps
    +listaEscolar : any
    +perfil : PerfilUsuario
    +materiasProfessor : string[]
    +scrollRef : MutableRefObject
    +render()
}

class useChatBox {
    +isOpen : boolean
    +isHelpMode : boolean
    +input : string
    +messages : Message[]
    +loading : boolean
    +closeChat() : void
    +handleSend() : void
}

class useGeminiChat {
    +messages : Message[]
    +loading : boolean
    +chatRef : MutableRefObject
    +sendMessage(input: string) : Promise
}

class CarregamentoDados {
    +resumoEventosCalendario : string
    +perguntasFrequentes : string
    +resumoAtividadesAbertas : string
    +resumoPostProfessor : string
    +carregarPostsProfessor() : Promise
    +perguntas() : Promise
    +carregarResumoEventos() : Promise
    +carregarAtividadesAbertas() : Promise
}

class Mural {
    +turmaId : string
    +perfil : PerfilUsuario
    +render()
}
class useMural {
    +posts : Post[]
    +loading : boolean
    +comentarioInputs : Record
    +criarPost(conteudo: string, arquivoUrl?: string) : Promise
    +deletarPost(postId: string) : Promise
    +criarComentario(postId: string) : Promise
    +deletarComentario(comentarioId: string) : Promise
}

class Calendario {
    +perfil : PerfilUsuario
    +inscricoes : Record
    +turmasGlobais : Record
    +render()
}
class useCalendario {
    +eventos : Evento[]
    +loading : boolean
    +novoEvento : NovoEvento
    +carregarEventos() : Promise
    +criarEvento() : Promise
    +deletarEvento(id: string) : Promise
}

class Mensagens {
    +perfil : PerfilUsuario
    +render()
}
class useMensagens {
    +conversas : Conversa[]
    +chatAtivo : Chat | null
    +mensagens : Mensagem[]
    +loading : boolean
    +enviarMensagem(texto: string) : Promise
    +selecionarChat(id: string) : void
    +iniciarConversa(destinatarioId: string) : Promise
}

class DuvidasBox {
    +perfil : PerfilUsuario
    +render()
}
class useDuvidas {
    +duvidas : Duvida[]
    +loading : boolean
    +novaDuvida : NovaDuvida
    +criarDuvida() : Promise
    +resolverDuvida(id: string) : Promise
    +responderDuvida(id: string, resposta: string) : Promise
}

class Suporte {
    +render()
}
class useSuporte {
    +tickets : Ticket[]
    +loading : boolean
    +criarTicket(assunto: string, mensagem: string) : Promise
    +denunciarUsuario(alunoId: string, motivo: string) : Promise
}

class Pesquisar {
    +turmas : Record
    +aoFecharPesquisa : () => void
    +render()
}
class usePesquisa {
    +termoPesquisa : string
    +resultados : Turma[]
    +pesquisar(termo: string) : void
}

class TurmaCard {
    +materia : string
    +professor : string
    +banners : string
    +fotoProfessor : string
    +sala : string
    +turma : string
    +inscrito : boolean
    +compacto : boolean
    +modoPesquisa : boolean
    +clickMural() : void
    +clickInscrito() : void
    +perfil : PerfilUsuario
    +render()
}

class BoxPerfilUsuario {
    +render()
}
class usePerfilUsuario {
    +perfilEditado : PerfilUsuario
    +loading : boolean
    +salvarAlteracoes() : Promise
    +deletarConta() : Promise
}

class BoxEntregaAtividade {
    +atividadeId : string
    +perfil : PerfilUsuario
    +render()
}
class useEntregas {
    +entregas : Entrega[]
    +loading : boolean
    +novaEntrega : NovaEntrega
    +enviarEntrega() : Promise
    +avaliarEntrega(entregaId: string, nota: number) : Promise
}

%% Relations Layout & Routing
ProtectedRoute "1" ..> "1" useAuth : autentica
ProtectedRoute "1" *-- "0..1" LayoutPrincipal : renderiza
LayoutPrincipal "1" ..> "1" useGerenciador : consome
LayoutPrincipal "1" ..> "1" useEscolaDados : carrega dados com
LayoutPrincipal "1" *-- "1" GerenciadorTelas : renderiza
LayoutPrincipal "1" *-- "0..1" ChatBot : renderiza

%% Relations ChatBot
ChatBot "1" ..> "1" useChatBox : gerencia estado com
useChatBox "1" ..> "1" useGeminiChat : comunica via
useGeminiChat "1" ..> "1" CarregamentoDados : carrega dados com

%% Relations Features & Router
GerenciadorTelas "1" *-- "0..1" Mural : exibe
GerenciadorTelas "1" *-- "0..1" Calendario : exibe
GerenciadorTelas "1" *-- "0..1" Mensagens : exibe
GerenciadorTelas "1" *-- "0..1" DuvidasBox : exibe
GerenciadorTelas "1" *-- "0..1" Suporte : exibe
GerenciadorTelas "1" *-- "0..1" Pesquisar : exibe
GerenciadorTelas "1" *-- "0..1" BoxPerfilUsuario : exibe
GerenciadorTelas "1" *-- "0..*" TurmaCard : renderiza
Pesquisar "1" *-- "0..*" TurmaCard : renderiza
Mural "1" *-- "0..*" BoxEntregaAtividade : renderiza

Mural "1" ..> "1" useMural : gerencia posts com
Calendario "1" ..> "1" useCalendario : gerencia eventos com
Mensagens "1" ..> "1" useMensagens : gerencia conversas com
DuvidasBox "1" ..> "1" useDuvidas : gerencia dúvidas com
Suporte "1" ..> "1" useSuporte : gerencia tickets com
Pesquisar "1" ..> "1" usePesquisa : busca turmas com
BoxPerfilUsuario "1" ..> "1" usePerfilUsuario : atualiza dados com
BoxEntregaAtividade "1" ..> "1" useEntregas : gerencia entregas com

@enduml
